# =============================================================================
# 职场狼人杀 - 环境变量配置示例
# =============================================================================
# 使用方法：复制本文件为 .env，然后填入你的实际值
#   cp .env.example .env
#
# 配置优先级：MODEL_SEAT_N_* > MODEL_DEFAULT_* > 硬编码回退
# 后端自动选择：设了 BASE_URL → OpenAI兼容接口，未设 → 百炼平台
# =============================================================================

# ── 百炼平台（默认后端）─────────────────────────────────────────────────────
# 只需设置这一项即可运行，所有座位默认使用 qwen-max + 思维链开启
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ── 默认模型配置（所有座位通用）────────────────────────────────────────────
# 不设置则使用硬编码回退：model_name=qwen-max, enable_thinking=true, stream=true
# MODEL_DEFAULT_MODEL_NAME=qwen-max
# MODEL_DEFAULT_ENABLE_THINKING=true
# MODEL_DEFAULT_STREAM=true
# MODEL_DEFAULT_GENERATE_KWARGS={"temperature":0.7,"top_p":0.9}
# MODEL_DEFAULT_API_KEY=sk-xxxxxxxx

# 百炼平台自定义端点（一般不需要，除非使用私有化部署）
# MODEL_DEFAULT_BASE_HTTP_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── OpenAI 兼容接口（设了 BASE_URL 即切换）───────────────────────────────
# 全部座位使用 OpenAI（取消注释即可启用）：
# MODEL_DEFAULT_BASE_URL=https://api.openai.com/v1
# MODEL_DEFAULT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# MODEL_DEFAULT_MODEL_NAME=gpt-4o

# ── 按座位号分配不同模型 ───────────────────────────────────────────────────
# 格式：MODEL_SEAT_{座位号}_{字段名}，座位号 1-12
# 未配置的座位使用 MODEL_DEFAULT_* 或硬编码回退

# 1号位：百炼平台 qwen-max（思维链开启）
# MODEL_SEAT_1_MODEL_NAME=qwen-max
# MODEL_SEAT_1_ENABLE_THINKING=true

# 2号位：百炼平台 qwen-plus（快速，无思维链）
# MODEL_SEAT_2_MODEL_NAME=qwen-plus
# MODEL_SEAT_2_ENABLE_THINKING=false

# 3号位：OpenAI GPT-4o
# MODEL_SEAT_3_MODEL_NAME=gpt-4o
# MODEL_SEAT_3_BASE_URL=https://api.openai.com/v1
# MODEL_SEAT_3_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 4号位：DeepSeek
# MODEL_SEAT_4_MODEL_NAME=deepseek-chat
# MODEL_SEAT_4_BASE_URL=https://api.deepseek.com/v1
# MODEL_SEAT_4_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 5号位：本地 Ollama（需先启动 ollama serve）
# MODEL_SEAT_5_MODEL_NAME=qwen3:8b
# MODEL_SEAT_5_BASE_URL=http://localhost:11434/v1
# MODEL_SEAT_5_API_KEY=not-needed

# 6号位：本地 vLLM
# MODEL_SEAT_6_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
# MODEL_SEAT_6_BASE_URL=http://localhost:8000/v1
# MODEL_SEAT_6_API_KEY=not-needed

# ── OpenAI 兼容接口额外参数 ────────────────────────────────────────────────
# client_args 会传入 openai.AsyncClient()，可设置 timeout、max_retries 等
# MODEL_SEAT_3_CLIENT_ARGS={"timeout":60,"max_retries":3}

# generate_kwargs 会传入模型生成调用
# MODEL_SEAT_3_GENERATE_KWARGS={"temperature":0.5,"top_p":0.9}

# ── 环境变量完整参考 ────────────────────────────────────────────────────────
#
# | 环境变量                        | 后端   | 说明                       |
# |--------------------------------|--------|----------------------------|
# | DASHSCOPE_API_KEY              | 百炼   | 百炼 API Key（全局回退）    |
# | MODEL_DEFAULT_MODEL_NAME       | 通用   | 默认模型名                 |
# | MODEL_DEFAULT_ENABLE_THINKING  | 百炼   | 思维链开关(true/false)      |
# | MODEL_DEFAULT_STREAM           | 通用   | 流式输出(true/false)        |
# | MODEL_DEFAULT_API_KEY          | 通用   | 默认 API Key               |
# | MODEL_DEFAULT_BASE_URL         | OpenAI | 默认接口地址               |
# | MODEL_DEFAULT_BASE_HTTP_API_URL| 百炼   | 百炼自定义端点             |
# | MODEL_DEFAULT_GENERATE_KWARGS  | 通用   | 生成参数(JSON)             |
# | MODEL_DEFAULT_CLIENT_ARGS      | OpenAI | 客户端参数(JSON)           |
# | MODEL_SEAT_N_MODEL_NAME        | 通用   | N号位模型名                |
# | MODEL_SEAT_N_ENABLE_THINKING   | 百炼   | N号位思维链                |
# | MODEL_SEAT_N_STREAM            | 通用   | N号位流式输出              |
# | MODEL_SEAT_N_API_KEY           | 通用   | N号位 API Key              |
# | MODEL_SEAT_N_BASE_URL          | OpenAI | N号位接口地址              |
# | MODEL_SEAT_N_GENERATE_KWARGS   | 通用   | N号位生成参数(JSON)        |
# | MODEL_SEAT_N_CLIENT_ARGS       | OpenAI | N号位客户端参数(JSON)      |
#
# N = 座位号，范围 1-12
# 设置了 BASE_URL 的座位自动使用 OpenAI 兼容接口，未设置的使用百炼平台
